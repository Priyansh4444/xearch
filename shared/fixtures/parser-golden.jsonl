{"raw": "convex hackathon from:@jamwt", "tier": "A", "expect": {"must": ["convex", "hackathon"], "authorHandle": "jamwt"}, "note": "pure operators"}
{"raw": "mars from:@elonmusk since:7d sort:latest", "tier": "A", "expect": {"must": ["mars"], "authorHandle": "elonmusk", "sinceRelativeDays": 7, "sort": "latest"}, "note": "relative date operator"}
{"raw": "\"exact phrase\" -iphone has:image", "tier": "A", "expect": {"phrases": [["exact", "phrase"]], "exclude": ["iphone"], "media": "image"}, "note": "phrase + negation + media operator"}
{"raw": "linux box cheap", "tier": "B", "expect": {"must": ["linux", "box"], "aspects": ["~price"], "should": ["cheap"]}, "note": "weak aspect trigger fires: content tokens present (ASPECTS G5)"}
{"raw": "cheap", "tier": "B", "expect": {"must": ["cheap"], "aspects": []}, "note": "weak trigger alone does NOT fire; stays literal"}
{"raw": "height of taj mahal", "tier": "B", "expect": {"must": ["taj", "mahal"], "aspects": ["~spec"], "intent": "question"}, "note": "attribute survives as structure"}
{"raw": "pics of the sf skyline last summer", "tier": "B", "expect": {"must": ["sf", "skyline"], "media": "image", "hasDateWindow": true, "intent": "media"}, "note": "media lexicon + temporal lexicon + glue strip"}
{"raw": "what did karpathy say about llm agents?", "tier": "B", "expect": {"must": ["llm", "agents"], "authorHandle": "karpathy", "intent": "question"}, "note": "glue strip + entity link; mode NOT set (user chooses)"}
{"raw": "cybertruck vs rivian", "tier": "B", "expect": {"must": ["cybertruck", "rivian"], "intent": "compare", "aspects": ["~compare"]}, "note": "vs is glue AND compare signal"}
{"raw": "apple tweets not about the iphone", "tier": "B", "expect": {"must": ["apple"], "exclude": ["iphone"]}, "note": "NL negation"}
{"raw": "million man march tweets", "tier": "B", "expect": {"must": ["million", "man", "march"], "hasDateWindow": false}, "note": "bare month name must NOT bind as date (RISKS P4)"}
{"raw": "jack of all trades", "tier": "B", "expect": {"must": ["jack", "all", "trades"], "authorHandle": null}, "note": "common-word name must NOT entity-link (RISKS P1)"}
{"raw": "tweets during the openai board drama", "tier": "C", "expect": {"must": ["openai"], "hasDateWindow": true, "intent": "event"}, "note": "event anchor -> Tier C resolves window, cached forever"}
{"raw": "that thread where someone benchmarked rust vs go web servers", "tier": "C", "expect": {"mustIncludes": ["rust", "go"], "paraphrasesMin": 2}, "note": "prose -> parse + expansions"}
