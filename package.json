{
  "name": "xearch",
  "version": "0.1.0",
  "private": true,
  "description": "Search engine for tweets on Convex — see DESIGN.md / ARCHITECTURE.md",
  "type": "module",
  "scripts": {
    "collect:pilot": "node apps/collector/src/cli/pilot.ts",
    "collect:probe": "node apps/collector/src/cli/probe.ts",
    "collect:pull": "bash apps/collector/scripts/pull-run.sh",
    "collect:push-status": "bash apps/collector/scripts/push-status.sh",
    "collect:sync": "bash apps/collector/scripts/sync-runs.sh",
    "dev": "convex dev",
    "test": "vitest run",
    "test:golden": "vitest run tests/tokenizer.golden.test.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "codegen": "convex codegen",
    "prepare": "effect-tsgo patch --no-typescript --oxlint",
    "typecheck": "tsc --noEmit && pnpm --filter xearch-web typecheck",
    "web": "pnpm --filter xearch-web dev",
    "doctor": "react-doctor --no-telemetry --no-supply-chain"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.112",
    "convex": "^1.45.0",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.44.0",
    "@types/node": "^26.4.1",
    "convex-test": "^0.0.56",
    "jsdom": "^30.0.1",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "react-doctor": "^0.9.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.10.0"
}
